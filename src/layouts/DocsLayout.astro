---
import Base from "./Base.astro";
import Icons from "../components/Icons.astro";
import { docsNav, docsOrder } from "../data/docs-nav";

export interface TocEntry {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  /** Breadcrumb trail after "Docs". */
  breadcrumbs?: { label: string; href?: string }[];
  toc?: TocEntry[];
  updated?: string;
}

const {
  title,
  description,
  breadcrumbs = [],
  toc = [],
  updated = "2026-09-04",
} = Astro.props;

const path = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const index = docsOrder.findIndex((link) => link.href === path);
const prev = index > 0 ? docsOrder[index - 1] : undefined;
const next = index >= 0 && index < docsOrder.length - 1 ? docsOrder[index + 1] : undefined;
---

<Base title={`${title} — Aegis docs`} description={description}>
  <header class="docs-top">
    <div class="docs-top-inner">
      <a class="brand" href="/">Aegis</a>
      <span class="divider" aria-hidden="true">/</span>
      <a class="docs-label" href="/docs/">Documentation</a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="docs-sidebar"
      >
        Menu
      </button>
      <a
        class="gh"
        href="https://github.com/aegis/aegis"
        rel="noopener"
      >
        <Icons name="github" size={20} />
        <span>GitHub</span>
      </a>
    </div>
  </header>

  <div class="docs-shell">
    <aside class="sidebar" id="docs-sidebar" aria-label="Documentation">
      <div class="sidebar-tools">
        <label class="docs-search">
          <Icons name="search" size={16} />
          <span class="sr-only">Search documentation</span>
          <input
            type="search"
            placeholder="Search docs"
            autocomplete="off"
            data-docs-search
          />
          <kbd>/</kbd>
        </label>
      </div>
      <nav data-docs-nav>
        {docsNav.map((section) => (
          <div class="nav-group">
            <h2>{section.title}</h2>
            <ul>
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={["nav-link", link.href === path && "active"]}
                    aria-current={link.href === path ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <p class="search-empty" data-search-empty hidden>No matching pages.</p>
    </aside>

    <button class="sidebar-backdrop" type="button" aria-label="Close documentation menu"></button>

    <main class="docs-main">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/docs/">Docs</a>
        {breadcrumbs.map((crumb) => (
          <>
            <span aria-hidden="true">/</span>
            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
          </>
        ))}
      </nav>

      <h1>{title}</h1>
      <p class="lede">{description}</p>

      <article class="prose"><slot /></article>

      <nav class="pager" aria-label="Pagination">
        {prev ? (
          <a class="pager-link prev" href={prev.href}>
            <span>Previous</span>
            <strong>{prev.label}</strong>
          </a>
        ) : <span />}
        {next && (
          <a class="pager-link next" href={next.href}>
            <span>Next</span>
            <strong>{next.label}</strong>
          </a>
        )}
      </nav>

      <p class="updated">Last updated: {updated}</p>
    </main>

    <aside class="toc" aria-label="On this page">
      {toc.length > 0 && (
        <div class="toc-inner">
          <h2>On this page</h2>
          <ul>
            {toc.map((entry) => (
              <li><a href={`#${entry.id}`}>{entry.label}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>

<script>
  const sidebar = document.querySelector<HTMLElement>("#docs-sidebar");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const backdrop = document.querySelector<HTMLButtonElement>(".sidebar-backdrop");
  const search = document.querySelector<HTMLInputElement>("[data-docs-search]");
  const empty = document.querySelector<HTMLElement>("[data-search-empty]");
  const navGroups = [...document.querySelectorAll<HTMLElement>(".nav-group")];

  const setMenuOpen = (open: boolean) => {
    sidebar?.classList.toggle("open", open);
    backdrop?.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("docs-menu-open", open);
    if (open) search?.focus();
  };

  toggle?.addEventListener("click", () => {
    setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
  });
  backdrop?.addEventListener("click", () => setMenuOpen(false));
  sidebar?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  const filterNavigation = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? "";
    let visibleCount = 0;
    navGroups.forEach((group) => {
      let groupCount = 0;
      group.querySelectorAll<HTMLLIElement>("li").forEach((item) => {
        const matches = item.textContent?.toLocaleLowerCase().includes(query) ?? false;
        item.hidden = !matches;
        if (matches) groupCount += 1;
      });
      group.hidden = groupCount === 0;
      visibleCount += groupCount;
    });
    if (empty) empty.hidden = visibleCount > 0;
  };
  search?.addEventListener("input", filterNavigation);

  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement;
    const isTyping = target.matches("input, textarea, select, [contenteditable='true']");
    if (event.key === "/" && !isTyping) {
      event.preventDefault();
      if (window.matchMedia("(max-width: 860px)").matches) setMenuOpen(true);
      search?.focus();
    }
    if (event.key === "Escape") {
      setMenuOpen(false);
      search?.blur();
    }
  });

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const headings = tocLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if (headings.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!visible) return;
      tocLinks.forEach((link) => {
        const active = link.hash === `#${visible.target.id}`;
        link.classList.toggle("active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }, { rootMargin: "-78px 0px -72%", threshold: 0 });
    headings.forEach((heading) => observer.observe(heading));
  }
</script>

<style is:global>
  /* Shared prose styles for every docs page. */
  .prose { font-size: 15.5px; color: var(--text-muted); }
  .prose h2 {
    margin: 48px 0 14px;
    padding-top: 8px;
    color: var(--text);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.015em;
    scroll-margin-top: 90px;
  }
  .prose h3 {
    margin: 32px 0 10px;
    color: var(--text);
    font-size: 17.5px;
    font-weight: 600;
    scroll-margin-top: 90px;
  }
  .prose p { margin: 0 0 16px; }
  .prose ul, .prose ol { margin: 0 0 16px; padding-left: 22px; }
  .prose li { margin: 0 0 8px; }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose strong { color: var(--text); font-weight: 600; }
  .prose code {
    padding: 2px 6px;
    border-radius: 5px;
    background: #121822;
    border: 1px solid var(--border-soft);
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: #d7e3f2;
  }
  .prose table {
    display: block;
    width: 100%;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-size: 14.5px;
    overflow-x: auto;
  }
  .prose th, .prose td {
    padding: 11px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border-soft);
  }
  .prose th {
    color: var(--text);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-bottom-color: var(--border);
  }
  .prose td code { white-space: nowrap; }
  .prose dl { margin: 0 0 20px; }
  .prose dt {
    margin: 18px 0 6px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .prose dd { margin: 0; padding-left: 18px; border-left: 1px solid var(--border-soft); }
</style>

<style>
  .docs-top {
    position: sticky;
    top: 0;
    z-index: 30;
    background: #05070a;
    border-bottom: 1px solid var(--border-soft);
  }
  .docs-top-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 62px;
    padding: 0 28px;
  }
  .brand { font-size: 18px; font-weight: 700; letter-spacing: -0.02em; }
  .divider { color: var(--text-dim); }
  .docs-label { color: var(--text-muted); font-size: 15px; }
  .docs-label:hover { color: var(--text); }
  .menu-toggle {
    display: none;
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-panel);
    color: var(--text-muted);
    cursor: pointer;
  }
  .gh {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    color: var(--text-muted);
    font-size: 14.5px;
  }
  .gh:hover { color: var(--text); }

  .docs-shell {
    display: grid;
    grid-template-columns: 262px minmax(0, 1fr) 220px;
    gap: 40px;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .sidebar {
    position: sticky;
    top: 62px;
    align-self: start;
    max-height: calc(100vh - 62px);
    overflow-y: auto;
    padding: 26px 20px 48px 0;
    border-right: 1px solid var(--border-soft);
  }
  .sidebar-tools { margin: 0 18px 26px 0; }
  .docs-search {
    height: 38px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--bg-panel);
    color: var(--text-dim);
  }
  .docs-search:focus-within { border-color: #345067; color: var(--accent); }
  .docs-search input {
    min-width: 0;
    width: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 13.5px;
  }
  .docs-search input::placeholder { color: var(--text-dim); }
  .docs-search kbd {
    min-width: 20px;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-dim);
    font: 11px var(--font-mono);
    text-align: center;
  }
  .search-empty { margin: 18px 0; color: var(--text-dim); font-size: 13.5px; }
  .nav-group + .nav-group { margin-top: 28px; }
  .nav-group h2 {
    margin: 0 0 10px;
    color: var(--text-dim);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .sidebar ul { margin: 0; padding: 0; list-style: none; }
  .nav-link {
    display: block;
    padding: 6px 12px 6px 10px;
    margin-right: 18px;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 14.5px;
    border-radius: 0 6px 6px 0;
  }
  .nav-link:hover { color: var(--text); background: #0d121a; }
  .nav-link.active {
    color: var(--accent);
    border-left-color: var(--accent);
    background: rgba(34, 195, 238, 0.07);
  }

  .docs-main { padding: 34px 0 72px; min-width: 0; }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--text-dim);
    font-size: 13.5px;
  }
  .crumbs a:hover { color: var(--text); }
  h1 {
    margin: 0 0 12px;
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .lede {
    margin: 0 0 8px;
    max-width: 720px;
    color: var(--text-muted);
    font-size: 17px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--border-soft);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-panel);
  }
  .pager-link:hover { border-color: #2b3547; }
  .pager-link span { color: var(--text-dim); font-size: 12.5px; }
  .pager-link strong { color: var(--text); font-size: 15px; font-weight: 600; }
  .pager-link.next { text-align: right; }

  .updated { margin: 24px 0 0; color: var(--text-dim); font-size: 13px; }

  .toc { position: sticky; top: 62px; align-self: start; padding: 40px 0; }
  .toc h2 {
    margin: 0 0 12px;
    color: var(--text-dim);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .toc ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 9px; }
  .toc a { color: var(--text-muted); font-size: 13.5px; line-height: 1.4; }
  .toc a:hover { color: var(--accent); }
  .toc a.active { color: var(--accent); }
  .sidebar-backdrop { display: none; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1180px) {
    .docs-shell { grid-template-columns: 240px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 860px) {
    .menu-toggle { display: inline-flex; margin-left: auto; }
    .gh { margin-left: 0; }
    .docs-shell { grid-template-columns: 1fr; gap: 0; }
    .sidebar {
      position: fixed;
      top: 62px;
      left: 0;
      z-index: 40;
      width: min(320px, calc(100vw - 48px));
      height: calc(100dvh - 62px);
      max-height: none;
      padding: 24px 20px 40px;
      border-right: 1px solid var(--border);
      background: var(--bg-alt);
      transform: translateX(-101%);
      transition: transform 180ms ease;
      box-shadow: 18px 0 42px rgba(0, 0, 0, 0.35);
    }
    .sidebar.open { transform: translateX(0); }
    .sidebar-tools { margin-right: 0; }
    .nav-link { margin-right: 0; }
    .sidebar-backdrop {
      position: fixed;
      inset: 62px 0 0;
      z-index: 35;
      display: block;
      border: 0;
      background: rgba(0, 0, 0, 0.55);
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }
    .sidebar-backdrop.open { opacity: 1; pointer-events: auto; }
    :global(body.docs-menu-open) { overflow: hidden; }
    .pager { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .docs-top-inner { gap: 9px; padding: 0 18px; }
    .gh { display: none; }
    .docs-label { font-size: 14px; }
  }
</style>
