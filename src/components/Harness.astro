---
import { getLang } from "../i18n/ui";
import { copy } from "../i18n/copy";

const lang = getLang(Astro.url);
const t = copy[lang].harness;

// The banner as the program prints it.
const banner = String.raw` █████╗ ███████╗ ██████╗ ██╗███████╗
██╔══██╗██╔════╝██╔════╝ ██║██╔════╝
███████║█████╗  ██║  ███╗██║███████╗
██╔══██║██╔══╝  ██║   ██║██║╚════██║
██║  ██║███████╗╚██████╔╝██║███████║
╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚═╝╚══════╝`;

/**
 * Only the commands the interface itself advertises. Each response is what the
 * program prints; nothing here is invented beyond that.
 */
const responses = {
  "/help": [
    { tone: "label", text: "commands" },
    { tone: "dim", text: "  /help          show this list" },
    { tone: "dim", text: "  /lang zh|en    switch interface language" },
    { tone: "label", text: "keys" },
    { tone: "dim", text: "  Enter          send" },
    { tone: "dim", text: "  ↑ ↓ PgUp       scroll history" },
    { tone: "dim", text: "  Ctrl+C         exit" },
  ],
  "/lang zh": [{ tone: "ok", text: "介面語言已切換為中文。" }],
  "/lang en": [{ tone: "ok", text: "Interface language set to English." }],
};
---

<section class="harness" id="harness" data-anim-scope>
  <div class="container">
    <h2>{t.title}</h2>
    <p class="lede">{t.body}</p>

    <div class="screen" data-screen>
      <pre class="banner" aria-label="AEGIS">{banner}</pre>

      <p class="subtitle">Code Security Review Agent Harness</p>
      <p class="boot">Type /help for commands &middot; Enter to send &middot; Ctrl+C to exit</p>

      <div class="log" data-log role="log" aria-live="polite"></div>

      <label class="prompt">
        <span class="caret" aria-hidden="true">&rsaquo;</span>
        <input
          type="text"
          data-input
          placeholder={t.placeholder}
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label={t.placeholder}
        />
      </label>

      <p class="status">/help commands &middot; /lang zh 中文 &middot; ↑↓/PgUp scroll &middot; Ctrl+C exit</p>
    </div>

    <div class="tips">
      <p class="hint">{t.hint}</p>
      <div class="chips">
        {t.suggestions.map((suggestion) => (
          <button type="button" class="chip" data-suggest={suggestion}>{suggestion}</button>
        ))}
      </div>
    </div>

    <p class="note">{t.note}</p>
  </div>
</section>

<script define:vars={{ responses }}>
  const screen = document.querySelector("[data-screen]");
  const log = document.querySelector("[data-log]");
  const input = document.querySelector("[data-input]");
  if (screen && log && input) {
    const history = [];
    let historyIndex = 0;

    const write = (text, tone) => {
      const line = document.createElement("p");
      line.className = `line ${tone ?? ""}`.trim();
      // textContent only: whatever is typed is data, never markup.
      line.textContent = text;
      log.append(line);
      log.scrollTop = log.scrollHeight;
    };

    const run = (raw) => {
      const command = raw.trim().replace(/\s+/g, " ");
      if (!command) return;

      write(`› ${command}`, "echo");
      history.push(command);
      historyIndex = history.length;

      const reply = responses[command.toLowerCase()];
      if (reply) {
        reply.forEach((entry) => write(entry.text, entry.tone));
      } else {
        write(`unknown command: ${command}`, "error");
        write("type /help for the list", "dim");
      }
    };

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        run(input.value);
        input.value = "";
        return;
      }
      // ↑ ↓ walk the history, the way the real prompt does.
      if (event.key === "ArrowUp" || event.key === "ArrowDown") {
        if (history.length === 0) return;
        event.preventDefault();
        historyIndex =
          event.key === "ArrowUp"
            ? Math.max(0, historyIndex - 1)
            : Math.min(history.length, historyIndex + 1);
        input.value = history[historyIndex] ?? "";
      }
    });

    document.querySelectorAll("[data-suggest]").forEach((chip) => {
      chip.addEventListener("click", () => {
        const command = chip.dataset.suggest ?? "";
        input.value = command;
        input.focus();
        run(command);
        input.value = "";
      });
    });

    // Clicking anywhere on the screen puts the caret in the prompt, like a TUI.
    screen.addEventListener("click", (event) => {
      if (event.target instanceof HTMLElement && event.target.closest("button")) return;
      input.focus();
    });
  }
</script>

<style>
  .harness {
    padding: 88px 0;
    border-top: 1px solid var(--border-soft);
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(26px, 3.4vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0 0 32px;
    max-width: 620px;
    color: var(--text-muted);
    font-size: 16px;
  }

  .screen {
    padding: 26px 26px 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #0b0d10;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    cursor: text;
  }
  .banner {
    margin: 0 0 14px;
    overflow-x: auto;
    font-size: clamp(7px, 1.15vw, 12px);
    line-height: 1.05;
    /* The gradient the program prints its banner in. */
    background: linear-gradient(100deg, var(--accent), var(--green));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .subtitle { margin: 0; color: var(--green); }
  .boot { margin: 0 0 18px; color: var(--text-dim); }

  .log {
    min-height: 168px;
    max-height: 300px;
    overflow-y: auto;
    margin-bottom: 16px;
    color: var(--text-muted);
  }
  .log :global(.line) { margin: 0; white-space: pre-wrap; }
  .log :global(.echo) { color: var(--text); }
  .log :global(.label) { color: var(--accent); }
  .log :global(.dim) { color: var(--text-dim); }
  .log :global(.ok) { color: var(--green); }
  .log :global(.error) { color: var(--red); }

  .prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid rgba(34, 195, 238, 0.45);
    border-radius: 8px;
    background: #090b0e;
  }
  .prompt:focus-within { border-color: var(--accent); }
  .caret { color: var(--accent); }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    outline: none;
  }
  input::placeholder { color: var(--text-dim); }

  .status { margin: 12px 0 0; color: var(--text-dim); font-size: 12px; }

  .tips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: 20px;
  }
  .hint { margin: 0; color: var(--text-muted); font-size: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
    cursor: pointer;
    transition: color 0.14s ease, border-color 0.14s ease;
  }
  .chip:hover { color: var(--accent); border-color: rgba(34, 195, 238, 0.5); }
  .chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .note { margin: 14px 0 0; color: var(--text-dim); font-size: 13px; }

  @media (max-width: 620px) {
    .harness { padding: 64px 0; }
    .screen { padding: 18px 16px 14px; font-size: 12px; }
    .log { min-height: 132px; }
  }
</style>
