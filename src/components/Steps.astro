---
import Icons from "./Icons.astro";
import { getLang } from "../i18n/ui";
import { copy } from "../i18n/copy";

const lang = getLang(Astro.url);
const t = copy[lang].steps;

// Icons, commands, metrics, and code locations are the same in both locales;
// only the prose comes from the dictionary.
const fixed = [
  { icon: "search" as const, command: "aegis scan --review", metric: "18", path: "src/api/users.ts:84" },
  { icon: "target" as const, command: "aegis test --from-scan", metric: "27", path: "GET /api/users?id=" },
  { icon: "shield-check" as const, command: "aegis report --format sarif", metric: "1", path: "src/api/users.ts:84" },
];

const stages = t.stages.map((stage, index) => ({ ...stage, ...fixed[index] }));
const payloads = t.payloads.map((payload, index) => ({
  ...payload,
  label: ["1", "1 OR 1=1", "1 UNION SELECT"][index],
  status: index === 0 ? "pass" : "fail",
}));
---

<section class="steps-section" id="how-it-works" data-anim-scope>
  <div class="container">
    <h2 class="section-title">{t.title}</h2>

    <div class="risk-workbench" data-workbench>
      <div class="stage-switcher" role="tablist" aria-label={t.switcher}>
        <span class="switch-pill" data-pill aria-hidden="true"></span>
        {stages.map((stage, index) => (
          <button
            class:list={["stage-chip", index === 0 && "active"]}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls="risk-stage"
            data-stage-trigger
            data-index={index}
          >
            <Icons name={stage.icon} size={18} />
            <span>{stage.label}</span>
          </button>
        ))}
      </div>

      <div class="risk-stage" id="risk-stage" role="tabpanel">
        <div class="diff-pane" aria-label={t.diffPane}>
          <span class="pane-progress" data-progress aria-hidden="true"></span>
          <div class="pane-head">
            <span>src/api/users.ts</span>
            <span data-stage-signal>{stages[0].signal}</span>
          </div>
          <ol class="code-map" aria-hidden="true">
            <li data-line="0"><span>82</span><code>const id = req.query.id;</code></li>
            <li class="active" data-line="1"><span>83</span><code>const sql = `SELECT * FROM users WHERE id = $&#123;id&#125;`;</code></li>
            <li data-line="2"><span>84</span><code>db.query(sql, (err, rows) =&gt; {'{'}</code></li>
            <li><span>85</span><code>  return res.json(rows);</code></li>
          </ol>
          <div class="stage-dots">
            {stages.map((stage, index) => (
              <button
                class:list={["dot", index === 0 && "active"]}
                type="button"
                data-dot={index}
                aria-label={stage.label}
              ></button>
            ))}
          </div>
        </div>

        <div class="flow-pane">
          <div class="flow-head">
            <span>{t.trace.head}</span>
            <span class="flow-hint" data-payload-hint>{payloads[0].hint}</span>
          </div>

          <ol class="flow">
            {t.trace.kinds.map((kind, index) => (
              <li>
                <button
                  class:list={["flow-node", index === 0 && "focused"]}
                  type="button"
                  data-node={index}
                  aria-describedby="flow-verdict"
                >
                  <span class="flow-kind">{kind}</span>
                  <code class="flow-expr">
                    {index === 0 && "req.query.id"}
                    {index === 1 && "`... id = ${id}`"}
                    {index === 2 && "db.query(sql)"}
                  </code>
                  <code class="flow-value" data-node-value={index}>
                    {payloads[0].values[index]}
                  </code>
                </button>
              </li>
            ))}
          </ol>

          <div class="payload-picker">
            <p class="picker-label">{t.trace.replay}</p>
            <div class="picker-chips" role="group" aria-label={t.trace.payloadGroup}>
              {payloads.map((payload, index) => (
                <button
                  class:list={["chip", index === 0 && "active"]}
                  type="button"
                  data-payload={index}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {payload.label}
                </button>
              ))}
            </div>
          </div>

          <p
            class:list={["flow-verdict", payloads[0].status]}
            id="flow-verdict"
            data-verdict
            aria-live="polite"
          >
            {payloads[0].verdict}
          </p>
        </div>

        <div class="finding-pane" aria-label={t.findingPane}>
          <div class="finding-top">
            <span class="severity" data-stage-severity>{stages[0].severity}</span>
            <span class="count"><strong data-stage-metric>{stages[0].metric}</strong> <em data-stage-metric-label>{stages[0].metricLabel}</em></span>
          </div>
          <h3 data-stage-title>{stages[0].title}</h3>
          <p data-stage-detail>{stages[0].detail}</p>
          <dl>
            <div>
              <dt>{t.pathLabel}</dt>
              <dd data-stage-path>{stages[0].path}</dd>
            </div>
            <div>
              <dt>{t.fixLabel}</dt>
              <dd data-stage-fix>{stages[0].fix}</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="command-rail" aria-live="polite">
        <code><span>$</span> <strong data-stage-command>{stages[0].command}</strong></code>
        <p data-stage-output>{stages[0].output}</p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ stages, payloads }}>
  const workbench = document.querySelector("[data-workbench]");
  const triggers = Array.from(document.querySelectorAll("[data-stage-trigger]"));
  const fields = {
    signal: document.querySelector("[data-stage-signal]"),
    severity: document.querySelector("[data-stage-severity]"),
    metric: document.querySelector("[data-stage-metric]"),
    metricLabel: document.querySelector("[data-stage-metric-label]"),
    title: document.querySelector("[data-stage-title]"),
    detail: document.querySelector("[data-stage-detail]"),
    path: document.querySelector("[data-stage-path]"),
    fix: document.querySelector("[data-stage-fix]"),
    command: document.querySelector("[data-stage-command]"),
    output: document.querySelector("[data-stage-output]"),
  };
  let activeIndex = 0;

  const pill = document.querySelector("[data-pill]");
  const progress = document.querySelector("[data-progress]");
  const dots = Array.from(document.querySelectorAll("[data-dot]"));
  const metricEl = document.querySelector("[data-stage-metric]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  // The active pill slides between chips instead of snapping.
  const movePill = () => {
    const active = triggers[activeIndex];
    if (!pill || !active) return;
    pill.style.transform = `translateX(${active.offsetLeft}px)`;
    pill.style.width = `${active.offsetWidth}px`;
  };

  // Replays the thin scan line across the top of the code pane.
  const runProgress = () => {
    if (!progress || reduced.matches) return;
    progress.classList.remove("running");
    void progress.offsetWidth;
    progress.classList.add("running");
  };

  // Counts the metric up to its new value rather than swapping the digits.
  let countFrame = 0;
  const countTo = (target) => {
    if (!metricEl) return;
    window.cancelAnimationFrame(countFrame);
    const end = Number(target);
    if (!Number.isFinite(end) || reduced.matches) {
      metricEl.textContent = String(target);
      return;
    }
    const start = performance.now();
    const duration = 460;
    const step = (now) => {
      const progressed = Math.min((now - start) / duration, 1);
      // ease-out so the last digits settle instead of ticking at full speed
      const eased = 1 - Math.pow(1 - progressed, 3);
      metricEl.textContent = String(Math.round(end * eased));
      if (progressed < 1) countFrame = window.requestAnimationFrame(step);
    };
    countFrame = window.requestAnimationFrame(step);
  };

  const setStage = (index) => {
    const stage = stages[index];
    activeIndex = index;
    workbench?.setAttribute("data-active", String(index));

    movePill();
    runProgress();
    dots.forEach((dot, dotIndex) => dot.classList.toggle("active", dotIndex === index));

    triggers.forEach((trigger, triggerIndex) => {
      const selected = triggerIndex === index;
      trigger.classList.toggle("active", selected);
      trigger.setAttribute("aria-selected", String(selected));
    });

    // The trace pane follows the stage: review inspects the source with a
    // normal value, probe replays an injection, verify shows what it proved.
    focusNode(index);
    setPayload(index);

    Object.values(fields).forEach((node) => node?.classList.add("is-changing"));
    window.setTimeout(() => {
      if (fields.signal) fields.signal.textContent = stage.signal;
      if (fields.severity) fields.severity.textContent = stage.severity;
      countTo(stage.metric);
      if (fields.metricLabel) fields.metricLabel.textContent = stage.metricLabel;
      if (fields.title) fields.title.textContent = stage.title;
      if (fields.detail) fields.detail.textContent = stage.detail;
      if (fields.path) fields.path.textContent = stage.path;
      if (fields.fix) fields.fix.textContent = stage.fix;
      if (fields.command) fields.command.textContent = stage.command;
      if (fields.output) fields.output.textContent = stage.output;
      Object.values(fields).forEach((node) => node?.classList.remove("is-changing"));
    }, 120);
  };

  triggers.forEach((trigger, index) => {
    trigger.addEventListener("click", () => {
      setStage(index);
    });
    trigger.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      event.preventDefault();
      const next = event.key === "ArrowRight"
        ? (index + 1) % triggers.length
        : (index - 1 + triggers.length) % triggers.length;
      triggers[next]?.focus();
      setStage(next);
    });
  });

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => setStage(index));
  });

  // Keep the pill aligned when the switcher is re-laid out.
  window.addEventListener("resize", movePill);

  // --- Taint trace ------------------------------------------------------
  // Picking a payload rewrites the value each node holds and the verdict.
  // Hovering or focusing a node highlights the matching line in the code pane.
  const nodes = Array.from(document.querySelectorAll("[data-node]"));
  const nodeValues = Array.from(document.querySelectorAll("[data-node-value]"));
  const chips = Array.from(document.querySelectorAll("[data-payload]"));
  const verdict = document.querySelector("[data-verdict]");
  const payloadHint = document.querySelector("[data-payload-hint]");
  const codeLines = Array.from(document.querySelectorAll(".code-map li"));
  const nodeToLine = [0, 1, 2];

  const setPayload = (index) => {
    const payload = payloads[index];

    chips.forEach((chip, chipIndex) => {
      const selected = chipIndex === index;
      chip.classList.toggle("active", selected);
      chip.setAttribute("aria-pressed", String(selected));
    });

    // The new value arrives at the source first and travels to the sink, so the
    // three rows update in sequence rather than all at once.
    nodeValues.forEach((node, nodeIndex) => {
      node.textContent = payload.values[nodeIndex];
      node.classList.remove("arriving");
      void node.offsetWidth;
      node.style.animationDelay = `${nodeIndex * 110}ms`;
      node.classList.add("arriving");
    });

    nodes.forEach((node, nodeIndex) => {
      node.classList.remove("lit");
      void node.offsetWidth;
      node.style.animationDelay = `${nodeIndex * 110}ms`;
      node.classList.add("lit");
    });

    if (payloadHint) payloadHint.textContent = payload.hint;
    if (verdict) {
      verdict.textContent = payload.verdict;
      verdict.classList.remove("updated");
      void verdict.offsetWidth;
      verdict.classList.add("updated");
      verdict.classList.remove("pass", "fail");
      verdict.classList.add(payload.status);
    }
  };

  chips.forEach((chip, index) => {
    chip.addEventListener("click", () => setPayload(index));
  });

  const focusNode = (index) => {
    nodes.forEach((node, nodeIndex) => {
      node.classList.toggle("focused", nodeIndex === index);
    });
    codeLines.forEach((line, lineIndex) => {
      line.classList.toggle("linked", lineIndex === nodeToLine[index]);
    });
  };

  nodes.forEach((node, index) => {
    node.addEventListener("pointerenter", () => focusNode(index));
    node.addEventListener("focus", () => focusNode(index));
    node.addEventListener("click", () => focusNode(index));
  });

  // Leaving the trace returns focus to the node the current stage is about.
  document.querySelector(".flow")?.addEventListener("pointerleave", () => {
    focusNode(activeIndex);
  });

  // Hovering a line of code lights the node that handles it — the reverse of
  // the node-to-line link, so the two panes read as one view.
  codeLines.forEach((line) => {
    const index = Number(line.dataset.line);
    if (!Number.isInteger(index)) return;
    line.addEventListener("pointerenter", () => focusNode(index));
  });
  document.querySelector(".code-map")?.addEventListener("pointerleave", () => {
    focusNode(activeIndex);
  });

  focusNode(0);

  setStage(0);
  requestAnimationFrame(movePill);

  // --- Entrance ---------------------------------------------------------
  // The panes arrive left to right the first time the workbench is on screen.
  if ("IntersectionObserver" in window) {
    const reveal = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.2 }
    );
    if (workbench) reveal.observe(workbench);
  } else {
    workbench?.classList.add("revealed");
  }
</script>

<style>
  .steps-section {
    padding: 96px 0 84px;
    background:
      radial-gradient(circle at 52% 4%, rgba(34, 195, 238, 0.1), transparent 35%),
      linear-gradient(180deg, var(--bg-alt), #05070a);
    border-top: 1px solid var(--border-soft);
  }
  .risk-workbench {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    position: relative;
    overflow: hidden;
    padding: 24px;
    border: 1px solid var(--border-soft);
    border-radius: 22px;
    background: transparent;
    transition: border-color 0.18s ease;
  }
  .stage-switcher {
    position: relative;
    z-index: 1;
    display: inline-flex;
    gap: 8px;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-panel);
  }
  .stage-chip {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 104px;
    justify-content: center;
    padding: 9px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
  }
  .stage-chip:hover,
  .stage-chip:focus-visible {
    color: var(--text);
    outline: 0;
    transform: translateY(-1px);
  }
  .stage-chip.active { color: #041b21; }
  .switch-pill {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--green));
    transition: transform 0.32s cubic-bezier(0.4, 0.6, 0.2, 1), width 0.32s cubic-bezier(0.4, 0.6, 0.2, 1);
    pointer-events: none;
  }
  .risk-stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(260px, 0.95fr) minmax(232px, 0.6fr) minmax(260px, 0.95fr);
    align-items: stretch;
    gap: 22px;
    margin-top: 24px;
    min-height: 390px;
  }
  .diff-pane,
  .finding-pane {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(6, 9, 14, 0.72);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.045);
  }
  .pane-head,
  .finding-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .pane-head span:last-child,
  .severity {
    color: var(--green);
    text-transform: uppercase;
  }
  .code-map {
    margin: 0;
    padding: 22px 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .code-map li {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 14px;
    padding: 10px 18px;
    color: var(--text-muted);
  }
  .code-map li span {
    color: var(--text-dim);
    text-align: right;
  }
  .code-map li.active {
    color: var(--text);
    background: linear-gradient(90deg, rgba(242, 85, 90, 0.14), transparent);
    box-shadow: inset 3px 0 0 var(--red);
  }
  .trace-dots {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: flex;
    gap: 9px;
  }
  .trace-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px rgba(34, 195, 238, 0.75);
    opacity: 0.85;
  }
  .trace-dots span:nth-child(2) { opacity: 0.62; }
  .trace-dots span:nth-child(3) { background: var(--green); opacity: 0.72; }
  /* Data-flow diagram: plain boxes, 1px rules, one accent. No glow, no
     rotation, nothing decorative that does not carry information. */
  /* Taint trace: a panel you can operate, built from type and 1px rules.
     No glow, no motion for its own sake. */
  .flow-pane {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border-left: 1px solid var(--border-soft);
    border-right: 1px solid var(--border-soft);
  }
  .flow-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .flow-hint {
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--text-muted);
  }

  .flow { margin: 0; padding: 0; list-style: none; }
  .flow li + li { margin-top: 24px; }
  .flow li { position: relative; }
  /* Connector with an arrowhead, drawn between consecutive nodes. */
  .flow li + li::before {
    content: "";
    position: absolute;
    left: 20px;
    top: -24px;
    width: 1px;
    height: 24px;
    background: var(--border);
  }
  .flow li + li::after {
    content: "";
    position: absolute;
    left: 17px;
    top: -7px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 5px solid var(--border);
  }

  .flow-node {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 4px 12px;
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: #0a0e14;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.14s ease, background-color 0.14s ease;
  }
  .flow-node:hover { border-color: #2b3547; }
  .flow-node:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .flow-node.focused {
    border-color: rgba(34, 195, 238, 0.5);
    background: rgba(34, 195, 238, 0.05);
  }
  .flow-kind {
    grid-column: 1 / -1;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .flow-expr {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .flow-node.focused .flow-expr { color: var(--text); }
  .flow-value {
    justify-self: end;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--amber);
  }

  .payload-picker { margin-top: 2px; }
  .picker-label {
    margin: 0 0 7px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .picker-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: border-color 0.14s ease, color 0.14s ease, background-color 0.14s ease;
  }
  .chip:hover { color: var(--text); border-color: #2b3547; }
  .chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chip.active {
    border-color: rgba(34, 195, 238, 0.55);
    background: rgba(34, 195, 238, 0.08);
    color: var(--accent);
  }

  .flow-verdict {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--border-soft);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .flow-verdict.pass { color: var(--green); }
  .flow-verdict.fail { color: var(--red); }

  /* Cross-panel link: the node under the pointer marks its line of code. */
  .code-map li.linked {
    color: var(--text);
    background: rgba(34, 195, 238, 0.06);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .finding-pane {
    padding-bottom: 20px;
  }
  .count strong {
    color: var(--green);
    font-size: 20px;
  }
  .count em {
    color: var(--text-dim);
    font-style: normal;
  }
  .finding-pane h3 {
    margin: 24px 22px 0;
    font-size: 28px;
    line-height: 1.1;
  }
  .finding-pane p {
    margin: 14px 22px 0;
    color: var(--text-muted);
  }
  .finding-pane dl {
    display: grid;
    gap: 12px;
    margin: 26px 22px 0;
  }
  .finding-pane dl div {
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.025);
  }
  dt {
    color: var(--text-dim);
    font-size: 12px;
  }
  dd {
    margin: 5px 0 0;
    color: var(--text);
    font-size: 14px;
  }
  .command-rail {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 22px;
    padding: 16px 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(5, 7, 10, 0.72);
    font-family: var(--font-mono);
  }
  .command-rail code {
