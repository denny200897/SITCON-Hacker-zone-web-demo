---
interface Props {
  name:
    | "shield"
    | "github"
    | "terminal"
    | "copy"
    | "search"
    | "target"
    | "shield-check"
    | "scale"
    | "laptop"
    | "workflow"
    | "users"
    | "rules"
    | "windows"
    | "arrow-right";
  size?: number;
  class?: string;
}

const { name, size = 24, class: klass = "" } = Astro.props;
const stroked = {
  width: size,
  height: size,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": 1.6,
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
  class: klass,
  "aria-hidden": "true",
};

// Solid glyphs need their own attribute set rather than overriding the
// stroked defaults, which would leave two conflicting fill/stroke pairs.
const filled = {
  width: size,
  height: size,
  viewBox: "0 0 24 24",
  fill: "currentColor",
  class: klass,
  "aria-hidden": "true",
};
---

{name === "shield" && (
  <svg {...stroked}><path d="M12 3l7 3v5.2c0 4.3-2.9 8.2-7 9.6-4.1-1.4-7-5.3-7-9.6V6l7-3z"/><path d="M14.2 9.6a3 3 0 1 0 0 4.8"/></svg>
)}
{name === "github" && (
  <img
    src="/assets/github-mark.png"
    width={size}
    height={size}
    alt=""
    aria-hidden="true"
    decoding="async"
    class:list={["github-mark", klass]}
  />
)}
{name === "terminal" && (
  <svg {...stroked}><path d="M4 6l6 6-6 6"/><path d="M13 18h7"/></svg>
)}
{name === "copy" && (
  <svg {...stroked}><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
)}
{name === "search" && (
  <svg {...stroked}><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
)}
{name === "target" && (
  <svg {...stroked}><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 1.8V5M12 19v3.2M1.8 12H5M19 12h3.2"/></svg>
)}
{name === "shield-check" && (
  <svg {...stroked}><path d="M12 3l7 3v5.2c0 4.3-2.9 8.2-7 9.6-4.1-1.4-7-5.3-7-9.6V6l7-3z"/><path d="M9 12l2.2 2.2L15.5 10"/></svg>
)}
{name === "scale" && (
  <svg {...stroked}><path d="M12 4v16M7 20h10M5 8h14M12 4l-.2 4"/><path d="M5 8l-2.6 5a3 3 0 0 0 5.2 0L5 8zM19 8l-2.6 5a3 3 0 0 0 5.2 0L19 8z"/></svg>
)}
{name === "laptop" && (
  <svg {...stroked}><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M2 20h20"/><path d="M7.5 9l2.2 2.2-2.2 2.2M12.5 13.5h3.5"/></svg>
)}
{name === "workflow" && (
  <svg {...stroked}><circle cx="6" cy="5" r="2.2"/><circle cx="6" cy="19" r="2.2"/><circle cx="18" cy="12" r="2.2"/><path d="M6 7.2v9.6"/><path d="M8.2 5H13a3 3 0 0 1 3 3v1.8M8.2 19H13a3 3 0 0 0 3-3v-1.8"/></svg>
)}
{name === "users" && (
  <svg {...stroked}><circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17.5" cy="7.5" r="2.5"/><path d="M15.5 13.4A5 5 0 0 1 21 18"/></svg>
)}
{name === "rules" && (
  <svg {...stroked}><path d="M4 6h9M4 11h9M4 16h5"/><path d="M14.5 16.6l2 2 4-4.4"/></svg>
)}
{name === "windows" && (
  <svg {...filled}><path d="M3.5 6.1l7.2-1v6.4H3.5V6.1zm0 11.8l7.2 1v-6.3H3.5v5.3zm8.6 1.2l8.4 1.2V12.6h-8.4v6.5zm0-14.2v6.4h8.4V3.7l-8.4 1.2z"/></svg>
)}
{name === "arrow-right" && (
  <svg {...stroked}><path d="M4 12h15"/><path d="M13.5 6.5L20 12l-6.5 5.5"/></svg>
)}

<style>
  .github-mark {
    display: block;
    flex: 0 0 auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }
</style>
