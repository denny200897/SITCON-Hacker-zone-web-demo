---
/**
 * Chinese home page. Every component reads the locale from the URL, so the two
 * home pages share one component tree and differ only in their path.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import Steps from "../../components/Steps.astro";
import FeatureStrip from "../../components/FeatureStrip.astro";
import Docs from "../../components/Docs.astro";
import Contributors from "../../components/Contributors.astro";
import Footer from "../../components/Footer.astro";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Steps />
    <FeatureStrip />
    <Docs />
    <Contributors />
  </main>
  <Footer />
</Base>
